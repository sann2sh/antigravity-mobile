[Unit]
Description=Antigravity Mobile Companion
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/san/Desktop/Codespace/mobileterminal
ExecStart=/home/san/Desktop/Codespace/mobileterminal/start.sh
Restart=always
RestartSec=5
Environment=PATH=/home/san/.local/bin:/home/san/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
