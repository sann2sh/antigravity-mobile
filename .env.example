# Server bind address and port
HOST=0.0.0.0
PORT=8000

# Optional default workspace directory (defaults to user home/current directory if empty)
DEFAULT_WORKSPACE=

# Path or command name for the Antigravity CLI
AGY_BIN=agy

# Optional bearer token to protect /api/* and /ws/* routes
# Leave empty to disable authentication on private Tailscale/LAN networks
MOBILETERMINAL_TOKEN=
